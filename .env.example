# ==============================================================================
# CodeLift Environment Configuration Template (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# ─── CLIENT-SAFE (bundled into browser) ───────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ADMIN_WHATSAPP=919834671940
VITE_BASE_PATH=/platform/

# ─── SERVER-SIDE ONLY (migration scripts, NEVER in browser) ───────
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SEED_DEFAULT_PASSWORD=your-seed-password